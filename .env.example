# =============================================================================
#  Trading-System Konfiguration
# =============================================================================
#  Diese Datei nach `.env` kopieren und ausfuellen.
#  `.env` steht in .gitignore und wird NIE committet.
#
#  WARNUNG: API-Secrets niemals in einen Chat kopieren, niemals ins Repo.
# =============================================================================

# --- Bybit --------------------------------------------------------------
# environment: demo | testnet | mainnet
#   demo    -> api-demo.bybit.com   (ECHTE Marktdaten, Spielgeld)  <- Startpunkt
#   testnet -> api-testnet.bybit.com (separate Testwelt, andere Preise)
#   mainnet -> api.bybit.com         (ECHTES GELD)
BYBIT__ENVIRONMENT=demo
BYBIT__API_KEY=
BYBIT__API_SECRET=

# API-Key-Rechte auf Bybit:
#   [x] Read      [x] Trade      [ ] Withdrawal  <- NIEMALS aktivieren!
#   IP-Whitelist auf die VPS-IP setzen.

BYBIT__SYMBOL=BTCUSDT
BYBIT__CATEGORY=linear
BYBIT__RECV_WINDOW_MS=5000


# --- Risiko (Kill-Switch-Grenzen; die KI darf diese NICHT aendern) ------
RISK__RISK_PER_TRADE_PCT=0.75
RISK__MAX_LEVERAGE=3
RISK__MAX_CONCURRENT_POSITIONS=1
RISK__DAILY_LOSS_LIMIT_PCT=3.0
RISK__WEEKLY_LOSS_LIMIT_PCT=7.0
RISK__MAX_DRAWDOWN_PCT=15.0
RISK__MIN_STOP_DISTANCE_PCT=0.15
RISK__MAX_STOP_DISTANCE_PCT=3.0


# --- Kostenwaechter -----------------------------------------------------
# tier: build | demo | live | scale   (siehe core/config.py)
COST__TIER=build
COST__MONTHLY_BUDGET_EUR=300
COST__HARD_STOP_AT_PCT=100


# --- Anthropic (Research-KI) --------------------------------------------
LLM__ANTHROPIC_API_KEY=


# --- Datenbank ----------------------------------------------------------
DB__DSN=postgresql+psycopg://trading:trading@localhost:5432/trading


# --- Benachrichtigungen -------------------------------------------------
NOTIFY__TELEGRAM_BOT_TOKEN=
NOTIFY__TELEGRAM_CHAT_ID=


# --- Pfade ---------------------------------------------------------------
# state:      Betriebszustand, der einen Neustart ueberleben muss (Risk-Officer,
#             Kill-Switch). Gehoert ins Backup - Kerzen kann man nachladen,
#             einen ausgeloesten Kill-Switch nicht.
# strategies: Zugelassene Genome. Was hier liegt, hat die neun Gates bestanden.
PATHS__DATA_STORE=data_store
PATHS__STATE=state
PATHS__STRATEGIES=strategies
PATHS__LOGS=logs


# --- Dashboard ----------------------------------------------------------
# Leeres Passwort = Nur-Lese-Betrieb. Pause, Glattstellen und Not-Aus sind
# dann gesperrt - ein Not-Aus-Knopf ohne Passwort waere schlimmer als keiner.
WEB__PASSWORD=
# 127.0.0.1 = nur lokal erreichbar. Von aussen per SSH-Tunnel erreichen:
#   ssh -L 8000:localhost:8000 benutzer@server
WEB__HOST=127.0.0.1
WEB__PORT=8000
